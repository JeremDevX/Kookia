{
  "name": "foodai-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "lint": "eslint . && npm run check:css",
    "check:css": "node scripts/check-css.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "demo:local": "node scripts/localDemoSession.mjs",
    "demo:fixtures": "node scripts/localDemoSession.mjs --fixtures",
    "verify:local-delivery": "node scripts/localDeliveryRecipe.mjs",
    "preview": "vite preview",
    "test": "npm run test:css && vitest run",
    "test:css": "node --test scripts/*.test.mjs",
    "test:integration": "node scripts/runIntegrationTests.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "node --import tsx server/src/scripts/seedWorkspaces.ts",
    "import:invoices": "node --import tsx server/src/scripts/importSourceInvoices.ts",
    "simulate:restaurant": "node --import tsx server/src/scripts/simulateRestaurant.ts",
    "restore:restaurant-simulation": "node --import tsx server/src/scripts/restoreRestaurantSimulation.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^10.0.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.2",
    "vitest": "^4.0.18"
  }
}
