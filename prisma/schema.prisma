generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceDayStatus {
  open
  closed
}

enum WorkspaceMode {
  operational
  demo
}

enum ServiceDayCoverage {
  complete
  partial
  missing
}

enum ServiceDaySource {
  recorded
  demo_simulation
  mixed
}

enum SaleContributionSource {
  manual
  csv
  pos
  demo_simulation
}

enum SaleContributionStatus {
  pending
  accepted
  rejected
  superseded
  voided
}

enum SaleContributionEventKind {
  source_received
  accepted
  conflict_detected
  rejected
  replaced
  corrected
  voided
  refund_recorded
}

enum PosBatchCoverage {
  complete
  partial
}

enum PosBatchProvenance {
  recorded_sales
  demo_simulation
}

model User {
  id             String    @id @default(uuid())
  email          String
  emailNormalized String   @unique
  displayName    String
  passwordHash   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  sessions       Session[]
  restaurant     Restaurant?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model Restaurant {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  type         String
  address      String
  city         String
  phone        String
  email        String
  dailyCovers  Int
  mode         WorkspaceMode @default(operational)
  seededAt     DateTime @default(now())
  suppliers    Supplier[]
  products     Product[]
  stockCounts  StockCount[]
  recipes      Recipe[]
  predictions  Prediction[]
  movements    StockMovement[]
  invoiceDraftRevisions InvoiceDraftRevision[]
  productions  Production[]
  orders       PurchaseOrder[]
  receipts     PurchaseReceipt[]
  decisions    RecommendationDecision[]
  documents    WorkspaceDocument[]
  sales        DailySale[]
  saleItems    SaleItem[]
  saleImports  SaleImport[]
  serviceDays  ServiceDay[]
  saleContributions SaleContribution[]
  saleContributionEvents SaleContributionEvent[]
  recipeVersions RecipeVersion[]
  saleItemRecipeMappings SaleItemRecipeMapping[]
  posSyncStates PosSyncState[]
  posSalesBatches PosSalesBatch[]
  posArticleMappings PosArticleMapping[]
}

model Supplier {
  id           String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  products     Product[]
  receipts     PurchaseReceipt[]
  @@id([restaurantId, id])
}

model Product {
  id           String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  currentStock Decimal @db.Decimal(14, 3)
  unit         String
  minThreshold Decimal @db.Decimal(14, 3)
  supplierId   String
  supplier     Supplier @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  pricePerUnit Decimal @db.Decimal(14, 4)
  lastDelivery DateTime? @db.Date
  revision     Int @default(1)
  stockRevision Int @default(1)
  ingredients  RecipeIngredient[]
  recipeVersionIngredients RecipeVersionIngredient[]
  movements    StockMovement[]
  stockCounts  StockCount[]
  receiptLines PurchaseReceiptLine[]
  predictions  Prediction[]
  @@id([restaurantId, id])
}

model Recipe {
  id           String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  prepTime     Int
  yieldPortions Int @default(1)
  revision     Int @default(1)
  lastMade     DateTime? @db.Date
  ingredients  RecipeIngredient[]
  versions     RecipeVersion[]
  productions  Production[]
  saleItemMappings SaleItemRecipeMapping[]
  @@id([restaurantId, id])
}

model RecipeIngredient {
  restaurantId String
  recipeId     String
  productId    String
  quantity     Decimal @db.Decimal(14, 3)
  recipe       Recipe @relation(fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: Cascade)
  product      Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  @@id([restaurantId, recipeId, productId])
}

model RecipeVersion {
  id            String @id @default(uuid())
  restaurantId  String
  recipeId      String
  version       Int
  effectiveFrom DateTime? @db.Date
  operationId   String
  actorId       String
  name          String
  category      String
  prepTime      Int
  yieldPortions Int
  createdAt     DateTime @default(now())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipe        Recipe @relation(fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: NoAction)
  ingredients   RecipeVersionIngredient[]
  productions   Production[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, recipeId, version])
  @@unique([restaurantId, operationId])
  @@index([restaurantId, recipeId, effectiveFrom, version])
}

model RecipeVersionIngredient {
  restaurantId  String
  recipeVersionId String
  productId     String
  productName   String
  productUnit   String
  quantity      Decimal @db.Decimal(14, 3)
  recipeVersion RecipeVersion @relation(fields: [restaurantId, recipeVersionId], references: [restaurantId, id], onDelete: Cascade)
  product       Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)

  @@id([restaurantId, recipeVersionId, productId])
}

model StockMovement {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  delta        Decimal @db.Decimal(14, 3)
  reason       String
  operationId  String
  actorId      String
  sourceDocumentId       String?
  sourceContentHash      String?
  sourceDocumentRevision Int?
  invoiceDocumentId      String?
  invoiceRevision        Int?
  stockCountId            String?
  stockCount             StockCount? @relation(fields: [restaurantId, stockCountId], references: [restaurantId, id], onDelete: NoAction)
  productNameSnapshot    String?
  productUnitSnapshot    String?
  supplierNameSnapshot   String?
  unitPriceSnapshot      Decimal? @db.Decimal(14, 4)
  purchaseReceiptLineId  String?
  purchaseReceiptLine    PurchaseReceiptLine? @relation(fields: [restaurantId, purchaseReceiptLineId], references: [restaurantId, id], onDelete: NoAction)
  createdAt    DateTime @default(now())
  @@unique([restaurantId, operationId, productId])
  @@unique([restaurantId, purchaseReceiptLineId])
  @@index([restaurantId, productId, createdAt])
  @@index([restaurantId, sourceDocumentId])
}

model StockCount {
  id                  String
  restaurantId        String
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  countedQuantity     Decimal @db.Decimal(14, 3)
  theoreticalQuantity Decimal @db.Decimal(14, 3)
  delta               Decimal @db.Decimal(14, 3)
  unit                String
  stockRevisionBefore Int
  stockRevisionAfter  Int
  operationId         String
  actorId             String
  countDate           DateTime @db.Date
  countedAt           DateTime @default(now())
  movements           StockMovement[]

  @@id([restaurantId, id])
  @@unique([restaurantId, operationId])
  @@index([restaurantId, productId, countedAt])
}

model Production {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeId     String?
  recipe       Recipe? @relation(fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: NoAction)
  recipeVersionId String?
  recipeVersion RecipeVersion? @relation(fields: [restaurantId, recipeVersionId], references: [restaurantId, id], onDelete: NoAction)
  recipeName   String
  portions     Int
  prepTime     Int
  notes        String
  date         DateTime @db.Date
  kind         String
  actorId      String
  operationId  String
  createdAt    DateTime @default(now())
  @@unique([restaurantId, operationId])
  @@unique([restaurantId, id])
  @@index([restaurantId, recipeVersionId])
}

model Prediction {
  id                   String
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productId            String
  product              Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  predictedDate        DateTime @db.Date
  predictedConsumption Decimal @db.Decimal(14, 3)
  confidence           Float
  action               String?
  quantity             Decimal? @db.Decimal(14, 3)
  reason               String?
  source               String @default("demo")
  @@id([restaurantId, id])
}

model SaleItem {
  id             String @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  sales          DailySale[]
  contributions  SaleContribution[]
  recipeMappings SaleItemRecipeMapping[]
  posMappings    PosArticleMapping[]

  @@unique([restaurantId, normalizedName])
  @@unique([restaurantId, id])
}

model SaleItemRecipeMapping {
  id                String @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  saleItemId        String
  saleItem          SaleItem @relation(fields: [restaurantId, saleItemId], references: [restaurantId, id], onDelete: NoAction)
  recipeId          String
  recipe            Recipe @relation(fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: NoAction)
  recipeName        String
  revision          Int
  effectiveFrom     DateTime @db.Date
  portionsPerItem  Decimal @db.Decimal(14, 3)
  operationId       String
  actorId           String
  createdAt         DateTime @default(now())

  @@unique([restaurantId, id])
  @@unique([restaurantId, operationId])
  @@unique([restaurantId, saleItemId, revision])
  @@unique([restaurantId, saleItemId, effectiveFrom])
  @@index([restaurantId, saleItemId, effectiveFrom, revision])
}

model ServiceDay {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  serviceDate  DateTime @db.Date
  status       ServiceDayStatus
  coverage     ServiceDayCoverage
  source       ServiceDaySource @default(recorded)
  revision     Int @default(0)
  actorId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        DailySale[]

  @@id([restaurantId, serviceDate])
}

model DailySale {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  saleItemId   String
  saleItem     SaleItem @relation(fields: [restaurantId, saleItemId], references: [restaurantId, id], onDelete: NoAction)
  serviceDate  DateTime @db.Date
  serviceDay   ServiceDay @relation(fields: [restaurantId, serviceDate], references: [restaurantId, serviceDate], onDelete: NoAction)
  quantity     Int
  source       String   @default("manual")
  operationId  String
  importId     String?
  importRecord SaleImport? @relation(fields: [restaurantId, importId], references: [restaurantId, id], onDelete: NoAction)
  importLine   Int?
  contributionId String? @unique
  contribution SaleContribution? @relation(fields: [restaurantId, contributionId], references: [restaurantId, id], onDelete: NoAction)
  createdBy    String
  updatedBy    String
  revision     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([restaurantId, serviceDate, saleItemId])
  @@unique([restaurantId, operationId])
  @@unique([restaurantId, id])
  @@unique([restaurantId, contributionId])
  @@index([restaurantId, serviceDate])
}

model SaleImport {
  id            String   @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fileHash      String
  mappingHash   String
  mappingSnapshot Json
  acceptedCount Int
  rejectedCount Int
  conflictCount Int @default(0)
  createdBy     String
  createdAt     DateTime @default(now())
  sales         DailySale[]
  contributions SaleContribution[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, fileHash, mappingHash])
}

model PosSyncState {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider     String @db.VarChar(60)
  cursor       String? @db.VarChar(2000)
  lastBatchId  String? @db.VarChar(160)
  lastSuccessAt DateTime?
  revision     Int @default(0)
  updatedAt    DateTime @updatedAt

  @@id([restaurantId, provider])
}

model PosSalesBatch {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider     String @db.VarChar(60)
  batchId      String @db.VarChar(160)
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  cursorBefore String? @db.VarChar(2000)
  cursorAfter  String? @db.VarChar(2000)
  coverage     PosBatchCoverage
  provenance   PosBatchProvenance
  contentHash  String @db.Char(64)
  recordCount  Int
  candidateCount Int @default(0)
  duplicateRecordCount Int @default(0)
  createdBy    String
  createdAt    DateTime @default(now())
  contributions SaleContribution[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, provider, batchId])
  @@index([restaurantId, fromDate, toDate])
}

model PosArticleMapping {
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider       String @db.VarChar(60)
  externalItemId String @db.VarChar(120)
  saleItemId     String
  saleItem       SaleItem @relation(fields: [restaurantId, saleItemId], references: [restaurantId, id], onDelete: NoAction)
  actorId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([restaurantId, provider, externalItemId])
  @@index([restaurantId, saleItemId])
}

model SaleContribution {
  id             String @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  source          SaleContributionSource
  sourceKey       String
  sourceRevision  Int @default(1)
  importId        String?
  importRecord    SaleImport? @relation(fields: [restaurantId, importId], references: [restaurantId, id], onDelete: NoAction)
  importLine      Int?
  posBatchId      String?
  posBatch        PosSalesBatch? @relation(fields: [restaurantId, posBatchId], references: [restaurantId, id], onDelete: NoAction)
  sourceRecordId  String? @db.VarChar(160)
  sourceExternalItemId String? @db.VarChar(120)
  sourceRefunded  Boolean @default(false)
  sourceItemName  String @db.VarChar(120)
  sourceDate      String @db.VarChar(40)
  serviceDate     DateTime? @db.Date
  sourceQuantity  String @db.VarChar(32)
  quantity        Int?
  saleItemId      String?
  saleItem        SaleItem? @relation(fields: [restaurantId, saleItemId], references: [restaurantId, id], onDelete: NoAction)
  status          SaleContributionStatus
  reviewRevision  Int @default(0)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewReason    String? @db.VarChar(240)
  supersedesId    String?
  supersedes      SaleContribution? @relation("SaleContributionRevisions", fields: [restaurantId, supersedesId], references: [restaurantId, id], onDelete: NoAction)
  supersededBy    SaleContribution[] @relation("SaleContributionRevisions")
  dailySale       DailySale?
  events          SaleContributionEvent[]
  createdAt       DateTime @default(now())

  @@unique([restaurantId, id])
  @@unique([restaurantId, sourceKey])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, serviceDate, saleItemId])
}

model SaleContributionEvent {
  id             String @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  contributionId String
  contribution   SaleContribution @relation(fields: [restaurantId, contributionId], references: [restaurantId, id], onDelete: Cascade)
  operationId    String
  revision       Int
  kind           SaleContributionEventKind
  actorId        String
  reason         String @db.VarChar(240)
  snapshot       Json
  createdAt      DateTime @default(now())

  @@unique([restaurantId, operationId])
  @@index([restaurantId, contributionId, createdAt])
}

model PurchaseOrder {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actorId      String
  operationId  String
  status       String @default("validated")
  createdAt    DateTime @default(now())
  lines        PurchaseOrderLine[]
  receipts     PurchaseReceipt[]
  @@unique([restaurantId, operationId])
  @@unique([restaurantId, id])
}

model PurchaseOrderLine {
  id           String @id @default(uuid())
  restaurantId String
  orderId      String
  order        PurchaseOrder @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Cascade)
  productId    String
  productName  String
  supplierId   String
  supplierName String
  quantity     Decimal @db.Decimal(14, 3)
  unit         String
  pricePerUnit Decimal @db.Decimal(14, 4)
  suggestionDecisionId String? @unique
  suggestionDecision RecommendationDecision? @relation(fields: [suggestionDecisionId], references: [id], onDelete: SetNull)
  receiptLines PurchaseReceiptLine[]
  @@unique([restaurantId, id])
}

model PurchaseReceipt {
  id                         String @id @default(uuid())
  restaurantId               String
  restaurant                 Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId                    String
  order                      PurchaseOrder @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Cascade)
  supplierId                 String
  supplier                   Supplier @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  actorId                    String
  operationId                String
  invoiceReference           String
  invoiceReferenceNormalized String
  invoiceDocumentId          String
  invoiceDocumentRevision    Int
  deliveryReference          String
  deliveryDate               DateTime @db.Date
  sourceDocumentId            String?
  sourceContentHash           String?
  simulated                  Boolean @default(false)
  provenance                 String @default("recorded")
  invoiceComplete            Boolean @default(false)
  requestSnapshot            Json
  createdAt                  DateTime @default(now())
  lines                      PurchaseReceiptLine[]

  @@unique([restaurantId, operationId])
  @@unique([restaurantId, supplierId, invoiceReferenceNormalized, deliveryReference])
  @@unique([restaurantId, invoiceDocumentId, deliveryReference])
  @@unique([restaurantId, id])
  @@index([restaurantId, deliveryDate])
}

model PurchaseReceiptLine {
  id                    String @id @default(uuid())
  restaurantId          String
  receiptId             String
  receipt               PurchaseReceipt @relation(fields: [restaurantId, receiptId], references: [restaurantId, id], onDelete: Cascade)
  orderLineId           String
  orderLine             PurchaseOrderLine @relation(fields: [restaurantId, orderLineId], references: [restaurantId, id], onDelete: NoAction)
  productId             String
  product               Product @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  productName           String
  invoiceLineIndex      Int
  invoiceQuantity       Decimal @db.Decimal(14, 3)
  receivedQuantity      Decimal @db.Decimal(14, 3)
  quantityDifference   Decimal @db.Decimal(14, 3)
  unit                  String
  orderedQuantity       Decimal @db.Decimal(14, 3)
  orderedUnitPrice      Decimal @db.Decimal(14, 4)
  invoiceUnitPrice      Decimal @db.Decimal(14, 4)
  priceDifferenceReason String?
  movement              StockMovement?
  createdAt             DateTime @default(now())

  @@unique([restaurantId, id])
  @@unique([restaurantId, receiptId, orderLineId])
}

model RecommendationDecision {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actorId      String
  predictionId String?
  operationId  String
  decision     String
  snapshot     Json
  createdAt    DateTime @default(now())
  purchaseOrderLine PurchaseOrderLine?
  @@index([restaurantId, createdAt])
}

// Validated snapshots: analytics, preferences, notifications, invoices, menus,
// cart and simulator assumptions. Operational stock/order data stays relational.
model WorkspaceDocument {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind         String
  data         Json
  revision     Int @default(0)
  updatedAt    DateTime @updatedAt
  @@id([restaurantId, kind])
}

model InvoiceDraftRevision {
  restaurantId           String
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoiceDocumentId      String
  sourceDocumentId       String
  sourceContentHash       String
  sourceDocumentRevision Int
  revision                Int
  actorId                 String
  data                    Json
  createdAt               DateTime   @default(now())

  @@id([restaurantId, invoiceDocumentId, revision])
  @@index([restaurantId, sourceDocumentId, createdAt])
}
