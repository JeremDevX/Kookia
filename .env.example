DATABASE_URL=postgresql://kookia:kookia_dev@localhost:5432/kookia
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
SESSION_TTL_DAYS=7
NODE_ENV=development
# disabled | evaluation (prototyping/non-commercial, no API key) | commercial
OPEN_METEO_MODE=disabled
# OPEN_METEO_API_KEY=your-commercial-key
# Optional while disabled globally, for a single non-commercial test restaurant.
# OPEN_METEO_EVALUATION_RESTAURANT_ID=
# Optional, server-side only. Configure both to enable workshop imports into one test restaurant.
# WORKSHOP_IMPORT_TOKEN=
# WORKSHOP_IMPORT_RESTAURANT_ID=
# Set only if the configured restaurant is dedicated to testing and has operational mode.
# WORKSHOP_IMPORT_ALLOW_OPERATIONAL_TEST_WORKSPACE=true
# Enable the simulated dashboard forecast for the configured test restaurant only.
# WORKSHOP_FORECAST_ENABLED=true
# WORKSHOP_FOLLOW_VALIDATED_ORDERS_FROM=2026-11-21
